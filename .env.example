# Contact form delivery — set these in Vercel (Project → Settings → Environment Variables). Server-side only.
# Without them the form still works for visitors: it explains that messages can't be sent yet and points to Instagram / TikTok.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# For local development or staging only: write messages to the server console instead of sending them.
# CONTACT_MODE=log
