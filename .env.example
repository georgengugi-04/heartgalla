# Contact form delivery — set these in Vercel (Project → Settings → Environment Variables). Server-side only.
# Without them the form still works for visitors: it explains that messages can't be sent yet and points to Instagram / TikTok.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# For local development or staging only: write messages to the server console instead of sending them.
# CONTACT_MODE=log

# EartGalla Journeys — inquiries (server-side only). See supabase/migrations/0001_journeys.sql
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JOURNEYS_TO_EMAIL=
JOURNEYS_FROM_EMAIL=
# Local development only: log inquiries to the server console instead of storing them.
# JOURNEYS_MODE=log

# Journeys staff sign-in (anon key; never put the service role key here)
SUPABASE_ANON_KEY=
